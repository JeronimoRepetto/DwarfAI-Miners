{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@dwarfai/contracts": ["./src/contracts/index.ts"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/contracts/**/*.ts",
    "src/host/**/*.ts",
    "src/ui-main/**/*.ts",
    "src/legacy-bridge/**/*.ts",
    "spikes/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "electron.vite.config.ts",
    "electron.vite.jevMcpServer.config.ts",
    "electron.vite.host.config.ts",
    "vitest.config.ts",
    "vitest.golden.config.ts",
    "vitest.os.config.ts"
  ]
}
