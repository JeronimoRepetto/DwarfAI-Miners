node_modules/

# Build output. Anchored with a leading slash: an unanchored `release/` also
# matches at any depth, which silently swallowed skills/release/ — the pattern
# had no way to say it meant the packaging directory rather than any directory
# that happens to be named that.
/dist/
/release/
/out/
/coverage/
# tsc's incremental build cache — one per tsconfig, regenerated every build.
*.tsbuildinfo
.codex/*
.claude/*
.agent/*

.env
*.local
.codegraph/
.atl/
.DS_Store
Thumbs.db

#art
src/renderer/src/assets/art/aseprite
src/renderer/src/assets/art/dwarf-base
src/renderer/src/assets/art/skins
docs/dwarfai-miners-design/*
