# AgentName configuration.
# Copy to `.env` and adjust. All values are optional; defaults are shown below.

# Provider polling interval in milliseconds (integer >= 1).
POLL_INTERVAL_MS=2000

# Reserved general liveness window in seconds (integer >= 1).
LIVENESS_WINDOW_S=90

# Maximum Codex rollout age considered live, in seconds (integer >= 1).
CODEX_LIVENESS_WINDOW_S=300

# Mine-tier cache lifetime in seconds (integer >= 1).
TIER_CACHE_TTL_S=600

# Strictly increasing source-file thresholds for mine tiers.
TIER_COPPER_AT=25
TIER_SILVER_AT=100
TIER_GOLD_AT=400
TIER_URANIUM_AT=1500

# Semicolon-separated Claude configuration roots. A leading ~ is expanded.
CLAUDE_CONFIG_DIRS=~/.claude;~/.claude-multitec
