# DwarfAI-Miners configuration.
# Copy to `.env` and adjust. All values are optional; defaults are shown below.

# Provider polling interval in milliseconds (integer >= 1).
POLL_INTERVAL_MS=2000

# Reserved general liveness window in seconds (integer >= 1).
LIVENESS_WINDOW_S=90

# Maximum age of any observed Codex activity still considered live, in
# seconds (integer >= 1). Activity means: rollout growth since the previous
# scan, a logs_2.sqlite heartbeat, or the registry row timestamp — never the
# rollout mtime alone, which Windows freezes while the file is held open.
CODEX_LIVENESS_WINDOW_S=300

# How recent a Codex logs_2.sqlite row must be to count as a liveness
# heartbeat, in seconds (integer >= 1).
CODEX_HEARTBEAT_WINDOW_S=300

# How many day-directories (today back N-1 days) to scan for Codex rollouts
# (integer >= 1). A rollout lives in its START-date directory forever.
CODEX_SCAN_DAYS=7

# Extra seconds a quiet-but-open Codex rollout stays visible past
# CODEX_LIVENESS_WINDOW_S while a codex process is still running (integer >= 1).
CODEX_IDLE_RETENTION_S=3600

# The Codex sessions root to scan. A leading ~ is expanded.
CODEX_SESSIONS_ROOT=~/.codex/sessions

# Codex's authoritative thread registry, read read-only. A leading ~ is
# expanded. A missing file disables registry-backed discovery.
CODEX_STATE_DB=~/.codex/state_5.sqlite

# Codex's structured log stream, read read-only as a liveness heartbeat.
CODEX_LOGS_DB=~/.codex/logs_2.sqlite

# Mine-tier cache lifetime in seconds (integer >= 1).
TIER_CACHE_TTL_S=600

# Strictly increasing source-file thresholds for mine tiers.
TIER_COPPER_KB=100
TIER_SILVER_KB=500
TIER_GOLD_KB=2048
TIER_URANIUM_KB=8192

# Semicolon-separated Claude configuration roots. A leading ~ is expanded.
CLAUDE_CONFIG_DIRS=~/.claude;~/.claude-work

# How long a dwarf whose agent finished/disappeared stays visible with
# status 'leaving' before being dropped, in seconds (integer >= 1).
DWARF_LEAVE_GRACE_S=20

# Model the one-shot `claude -p` relay runs on when delivering a panel
# message to a headless Claude session. The relay only forwards a string,
# so the cheapest model is the right default.
SENDTEXT_RELAY_MODEL=haiku

# How long a message delivery may take before it is reported as timed out,
# in seconds (integer >= 1).
SENDTEXT_TIMEOUT_S=60

# Loopback port for the opt-in Claude hooks push channel (tray toggle).
HOOKS_PORT=47821
