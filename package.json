{
  "name": "dwarfai-miners",
  "productName": "DwarfAI-Miners",
  "version": "0.5.0",
  "description": "Floating panel that visualizes AI coding agents running on this PC as dwarfs working in mines.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.jeronimorepetto.dwarfaiminers",
    "productName": "DwarfAI-Miners",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "scripts": {
    "art:build": "node scripts/build-art.mjs",
    "icons": "node scripts/build-icons.mjs",
    "interior:map": "node scripts/build-interior-map.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "pnpm build && electron-builder --win nsis portable --x64 --publish never",
    "package:mac": "pnpm build && electron-builder --mac --publish never",
    "package:linux": "pnpm build && electron-builder --linux AppImage deb --x64 --publish never",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.258",
    "@fontsource/tiny5": "^5.3.0",
    "dotenv": "17.4.2",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "^2.5.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "jimp": "1.6.1",
    "jsdom": "^30.0.1",
    "png2icons": "2.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  },
  "author": {
    "name": "Jeronimo Repetto",
    "email": "jeronimo.repetto@multitecua.com"
  }
}
